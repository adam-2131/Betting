# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL works. The default below matches `npm run db:local`, which runs a real
# PostgreSQL server from an npm package - no Docker, no system install, no admin rights.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/polyalpha"

# Settings for `npm run db:local`. Change PGPORT if 5432 is already taken.
PGPORT=5432
PGDATA_DIR=".pgdata"
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=polyalpha

# ---------------------------------------------------------------------------
# Polymarket API (all public + keyless, read-only)
# ---------------------------------------------------------------------------
GAMMA_API_URL="https://gamma-api.polymarket.com"
DATA_API_URL="https://data-api.polymarket.com"
CLOB_API_URL="https://clob.polymarket.com"

# Client-side rate limits, requests per second per host. Kept well under published limits.
GAMMA_RATE_LIMIT_RPS=8
DATA_RATE_LIMIT_RPS=6
CLOB_RATE_LIMIT_RPS=8
POLYMARKET_MAX_CONCURRENCY=4
POLYMARKET_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------
# Bearer token required by POST /api/cron/sync. Generate your own for any deployment.
CRON_SECRET="change-me"

# How many active events to pull per market sync pass.
SYNC_MARKET_LIMIT=600

# Wallets refreshed per pass. This is a BUDGET, not the size of the watchlist — wallets are
# tiered by how likely a refresh is to change anything and each tier has its own minimum
# interval, so a watchlist of several thousand costs roughly what a few hundred used to.
# See src/lib/sync/trader-selection.ts.
SYNC_TRADER_LIMIT=250

# Wallets synced concurrently. The per-host token bucket still governs the request rate; this
# only stops it idling while one wallet pages through its closed-position history.
SYNC_TRADER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# All default to 0, meaning keep everything — right for a local instance on a real disk.
#
# SET THESE ON ANY HOSTED DEPLOYMENT. Left unbounded this database grows fast: a local instance
# reached 3 GB in a day, of which TradeActivity alone was 2 GB, and every free Postgres tier
# worth using caps at 0.5 GB. The values in DEPLOY.md keep it around 200 MB.
#
# Nothing here ever touches your bet log.
RETAIN_ACTIVITY_DAYS=0
RETAIN_SNAPSHOT_DAYS=0
RETAIN_RESOLVED_MARKET_DAYS=0
# Hard cap on tracked wallets. Deleting a wallet cascades to its positions, closed positions and
# activity, so this recovers more space than any other single setting. Manually added wallets are
# never dropped.
MAX_WATCHLIST=0

# ---------------------------------------------------------------------------
# Alerts (optional, and free)
# ---------------------------------------------------------------------------
# Leave blank and alerts are still recorded and readable at /alerts — they just are not pushed.
# The channel is detected from the URL, so there is nothing else to configure.
#
#   ntfy.sh    https://ntfy.sh/some-unguessable-topic-name
#              Install the ntfy app, subscribe to the same topic, done. No account.
#              The topic IS the password: anyone who guesses it can read your alerts.
#
#   Discord    https://discord.com/api/webhooks/...
#              Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
ALERT_WEBHOOK_URL=""

# Used to build links inside alerts. Set this to your deployed address once hosted.
PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Leave blank for local use and the app is open, which is fine on your own machine.
# Set it before exposing the app anywhere: there is one user and one password, and without it
# anything that can reach the port can read your betting record.
#
# The app holds no wallet, key or Polymarket credential, so this protects your record rather than
# your money. Over plain HTTP the password crosses the wire in the clear — see DEPLOY.md for two
# free ways to put HTTPS in front of it.
APP_PASSWORD=""
