{
  "name": "polyalpha",
  "version": "1.0.0",
  "private": true,
  "description": "PolyAlpha — read-only Polymarket smart-money intelligence dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "tsx scripts/sync.ts",
    "sync:markets": "tsx scripts/sync.ts --only=markets",
    "sync:traders": "tsx scripts/sync.ts --only=traders",
    "sync:scores": "tsx scripts/sync.ts --only=scores",
    "auto": "tsx scripts/auto-sync.ts",
    "alert:test": "tsx scripts/test-alert.ts",
    "backtest": "tsx scripts/backtest.ts",
    "db:local": "tsx scripts/db-local.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
